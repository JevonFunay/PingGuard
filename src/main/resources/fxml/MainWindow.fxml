<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gabut.pingguard.controller.MainController"
      spacing="0" prefWidth="520" prefHeight="640"
      stylesheets="@/fxml/style.css" styleClass="root-container">

    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
            <Label text="PingGuard" styleClass="app-title"/>
            <Label text="Network Latency Monitor" styleClass="app-subtitle"/>
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Label fx:id="statusIndicator" text="⏸" styleClass="status-emoji"/>
            <Label fx:id="statusLabel" text="Idle" styleClass="status-text"/>
        </HBox>
    </HBox>

    <HBox styleClass="stats-row" spacing="10" alignment="CENTER">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="LATENCY" styleClass="stat-label"/>
            <Label fx:id="latencyLabel" text="-- ms" styleClass="stat-value"/>
            <HBox alignment="CENTER" spacing="4">
                <Label text="Last:" styleClass="stat-sub-label"/>
                <Label fx:id="lastPingLabel" text="--:--:--" styleClass="stat-sub-value"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="PINGS" styleClass="stat-label"/>
            <Label fx:id="pingCountLabel" text="0" styleClass="stat-value-blue"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="SPIKES" styleClass="stat-label"/>
            <Label fx:id="spikeCountLabel" text="0" styleClass="stat-value-yellow"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="RTO" styleClass="stat-label"/>
            <Label fx:id="rtoCountLabel" text="0" styleClass="stat-value-red"/>
        </VBox>
    </HBox>

    <VBox fx:id="settingsPane" styleClass="settings-section" spacing="14">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <Label text="Configuration" styleClass="section-title"/>
        <VBox spacing="4">
            <Label text="Target IP / Hostname" styleClass="field-label"/>
            <TextField fx:id="ipField" promptText="e.g. 192.168.1.1 or 8.8.8.8" styleClass="config-input"/>
        </VBox>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Max Latency (ms)" styleClass="field-label"/>
                <TextField fx:id="thresholdField" promptText="e.g. 100" styleClass="config-input"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Interval (seconds)" styleClass="field-label"/>
                <TextField fx:id="intervalField" promptText="e.g. 5" styleClass="config-input"/>
            </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="startButton" text="Start Monitoring" styleClass="btn-start"
                    onAction="#onStartMonitoring" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="stopButton" text="Stop Monitoring" styleClass="btn-stop"
                    onAction="#onStopMonitoring" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

    <VBox styleClass="log-section" spacing="8" VBox.vgrow="ALWAYS">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <Label text="Activity Log" styleClass="section-title"/>
        <TextArea fx:id="logArea" styleClass="log-area" VBox.vgrow="ALWAYS" prefRowCount="8"/>
    </VBox>

    <HBox styleClass="footer-bar" alignment="CENTER" spacing="12">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
        <Label text="Closing window = runs in background" styleClass="footer-hint" HBox.hgrow="ALWAYS"/>
        <Button fx:id="exitButton" text="Exit Application" styleClass="btn-exit" onAction="#onExitApplication"/>
    </HBox>
</VBox>
